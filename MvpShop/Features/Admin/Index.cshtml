@model IReadOnlyList<MvpShop.Data.Entities.Product>
@{
    ViewData["Title"] = L.T("Admin");
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="mb-1">@L.T("ProductAdmin")</h1>
        <p class="text-muted mb-0">@L.T("ProductAdminText")</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" href="/">@L.T("OpenStorefront")</a>
        <a class="btn btn-primary" href="/products/create">@L.T("AddProduct")</a>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state text-center py-5 px-4">
        <h2 class="h4 mb-2">@L.T("CatalogEmpty")</h2>
        <p class="text-muted mb-3">@L.T("CreateFirstCatalogProduct")</p>
        <a class="btn btn-primary" href="/products/create">@L.T("CreateProduct")</a>
    </div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table align-middle mb-0 admin-table">
                <thead>
                    <tr>
                        <th>@L.T("Product")</th>
                        <th class="text-end">@L.T("Price")</th>
                        <th class="text-center">@L.T("CreatedAt")</th>
                        <th class="text-end">@L.T("Actions")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        var localizedName = L.ProductName(product.Name);
                        var localizedDescription = string.IsNullOrWhiteSpace(product.Description)
                            ? L.T("NoDescription")
                            : L.ProductDescription(product.Name, product.Description);
                        <tr>
                            <td>
                                <div class="fw-semibold">@localizedName</div>
                                <div class="small text-muted">@localizedDescription</div>
                            </td>
                            <td class="text-end">@product.Price.ToString("N2") ₽</td>
                            <td class="text-center">@product.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-2">
                                    <a class="btn btn-sm btn-outline-primary" href="/products/@product.Id">@L.T("Open")</a>
                                    <a class="btn btn-sm btn-outline-secondary" href="/products/@product.Id/edit">@L.T("Edit")</a>
                                    <a class="btn btn-sm btn-outline-danger" href="/products/@product.Id/delete">@L.T("Delete")</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
