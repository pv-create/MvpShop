@model MvpShop.Features.Cart.CartViewModel
@{
    ViewData["Title"] = "Корзина";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="mb-1">Корзина</h1>
        <p class="text-muted mb-0">Всего товаров: @Model.TotalQuantity</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" href="/">Продолжить покупки</a>
        @if (Model.Items.Count > 0)
        {
            <a class="btn btn-primary" href="/orders/checkout">Оформить заказ</a>
        }
    </div>
</div>

@if (Model.Items.Count == 0)
{
    <div class="empty-state text-center py-5 px-4">
        <h2 class="h4 mb-2">Корзина пуста</h2>
        <p class="text-muted mb-3">Добавьте товары из каталога, чтобы перейти к оформлению заказа.</p>
        <a class="btn btn-primary" href="/">Открыть каталог</a>
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Товар</th>
                                <th class="text-end">Цена</th>
                                <th class="text-center">Количество</th>
                                <th class="text-end">Сумма</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@item.Name</div>
                                        <div class="small text-muted">ID: @item.ProductId</div>
                                    </td>
                                    <td class="text-end">@item.Price.ToString("N2") ₽</td>
                                    <td class="text-center">
                                        <form method="post" action="/cart/update-quantity" class="d-inline-flex align-items-center justify-content-center gap-2">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <input type="number" name="quantity" value="@item.Quantity" min="0" class="form-control form-control-sm cart-quantity-input" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">Обновить</button>
                                        </form>
                                    </td>
                                    <td class="text-end fw-semibold">@((item.Price * item.Quantity).ToString("N2")) ₽</td>
                                    <td class="text-end">
                                        <form method="post" action="/cart/remove-item">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h2 class="h4 mb-3">Итого</h2>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Количество</span>
                        <strong>@Model.TotalQuantity</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-4">
                        <span>Сумма</span>
                        <strong>@Model.TotalAmount.ToString("N2") ₽</strong>
                    </div>

                    <div class="d-grid gap-2">
                        <a class="btn btn-primary" href="/orders/checkout">Оформить заказ</a>
                        <form method="post" action="/cart/clear">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger w-100">Очистить корзину</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
