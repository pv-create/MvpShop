@model MvpShop.Data.Entities.Product
@{
    ViewData["Title"] = "Удалить товар";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-danger shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-3">Удалить товар</h1>
                <p class="mb-4">Вы собираетесь удалить <strong>@Model.Name</strong>. Это действие нельзя отменить.</p>

                <dl class="row mb-0">
                    <dt class="col-sm-4">Цена</dt>
                    <dd class="col-sm-8">@Model.Price.ToString("N2") ₽</dd>

                    <dt class="col-sm-4">Описание</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Description) ? "Не указано" : Model.Description)</dd>
                </dl>
            </div>
            <div class="card-footer bg-white d-flex gap-2 justify-content-end">
                <a class="btn btn-outline-secondary" href="/products/@Model.Id">Отмена</a>
                <form method="post">
                    <button type="submit" class="btn btn-danger">Удалить</button>
                </form>
            </div>
        </div>
    </div>
</div>
