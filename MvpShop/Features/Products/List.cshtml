@model IReadOnlyList<MvpShop.Data.Entities.Product>
@{
    ViewData["Title"] = "Каталог";
}

<section class="hero-banner mb-5">
    <div class="row align-items-center g-4">
        <div class="col-lg-7">
            <div class="hero-banner__eyebrow">Nomadic Essentials</div>
            <h1 class="hero-banner__title">Монгол өнгө аястай амьдралын бараа</h1>
            <p class="hero-banner__text mb-0">Тал нутгийн уур амьсгал, ноолуур, эсгий, уламжлалт амтыг нэг дор цуглуулсан каталог.</p>
        </div>
        <div class="col-lg-5 text-lg-end">
            <div class="hero-banner__card">
                <div class="hero-banner__card-label">Онцлох цуглуулга</div>
                <div class="hero-banner__card-value">6 монгол бүтээгдэхүүн</div>
                <a class="btn btn-light mt-3" href="/admin">Перейти в админку</a>
            </div>
        </div>
    </div>
</section>

@if (Model.Count == 0)
{
    <div class="empty-state text-center py-5 px-4">
        <h2 class="h4 mb-2">Товаров пока нет</h2>
        <p class="text-muted mb-3">Создайте первую позицию через отдельную страницу администрирования.</p>
        <a class="btn btn-primary" href="/admin">Открыть админку</a>
    </div>
}
else
{
    <div class="section-heading d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="section-heading__label">Каталог</div>
            <h2 class="mb-1">Товары в монгольском стиле</h2>
            <p class="text-muted mb-0">Подборка вещей и продуктов, вдохновлённых культурой Монголии.</p>
        </div>
    </div>

    <div class="row g-4">
        @foreach (var product in Model)
        {
            var imageUrl = string.IsNullOrWhiteSpace(product.ImageUrl)
                ? "https://placehold.co/900x600/f4f4f0/222?text=MvpShop"
                : product.ImageUrl;

            <div class="col-md-6 col-xl-4">
                <div class="card h-100 shadow-sm border-0 product-card">
                    <img src="@imageUrl" class="card-img-top product-card__image" alt="@product.Name" />
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
                            <h2 class="h5 card-title mb-0">@product.Name</h2>
                            <span class="product-badge">@product.Price.ToString("N2") ₽</span>
                        </div>
                        <p class="card-text text-muted flex-grow-1">@(string.IsNullOrWhiteSpace(product.Description) ? "Описание пока не добавлено." : product.Description)</p>
                        <div class="d-flex gap-2">
                            <a class="btn btn-primary" href="/products/@product.Id">Открыть</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
