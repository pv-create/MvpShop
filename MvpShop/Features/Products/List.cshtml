@model IReadOnlyList<MvpShop.Data.Entities.Product>
@{
    ViewData["Title"] = L.T("Catalog");
}

<section class="hero-banner mb-5">
    <div class="row align-items-center g-4">
        <div class="col-lg-7">
            <div class="hero-banner__eyebrow">@L.T("HeroEyebrow")</div>
            <h1 class="hero-banner__title">@L.T("HeroTitle")</h1>
            <p class="hero-banner__text mb-0">@L.T("HeroText")</p>
        </div>
        <div class="col-lg-5 text-lg-end">
            <div class="hero-banner__card">
                <div class="hero-banner__card-label">@L.T("FeaturedCollection")</div>
                <div class="hero-banner__card-value">@L.F("FeaturedCount", Model.Count)</div>
                <a class="btn btn-light mt-3" href="/admin">@L.T("GoToAdmin")</a>
            </div>
        </div>
    </div>
</section>

@if (Model.Count == 0)
{
    <div class="empty-state text-center py-5 px-4">
        <h2 class="h4 mb-2">@L.T("NoProducts")</h2>
        <p class="text-muted mb-3">@L.T("CreateFirstProduct")</p>
        <a class="btn btn-primary" href="/admin">@L.T("OpenAdmin")</a>
    </div>
}
else
{
    <div class="section-heading d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="section-heading__label">@L.T("Catalog")</div>
            <h2 class="mb-1">@L.T("ProductsInStyle")</h2>
            <p class="text-muted mb-0">@L.T("ProductsInStyleText")</p>
        </div>
    </div>

    <div class="row g-4">
        @foreach (var product in Model)
        {
            var localizedName = L.ProductName(product.Name);
            var localizedDescription = string.IsNullOrWhiteSpace(product.Description)
                ? L.T("NoDescription")
                : L.ProductDescription(product.Name, product.Description);
            var imageUrl = L.ProductImageUrl(product.ImageUrl, product.Name, "https://placehold.co/900x600/f4f4f0/222?text=MvpShop");

            <div class="col-md-6 col-xl-4">
                <div class="card h-100 shadow-sm border-0 product-card">
                    <img src="@imageUrl" class="card-img-top product-card__image" alt="@localizedName" />
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
                            <h2 class="h5 card-title mb-0">@localizedName</h2>
                            <span class="product-badge">@product.Price.ToString("N2") ₽</span>
                        </div>
                        <p class="card-text text-muted flex-grow-1">@localizedDescription</p>
                        <div class="d-flex gap-2">
                            <a class="btn btn-primary" href="/products/@product.Id">@L.T("Open")</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
